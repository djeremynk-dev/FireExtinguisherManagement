    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "prisma": "^7.8.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}