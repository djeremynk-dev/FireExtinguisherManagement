{
  "name": "reporting-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch prisma --ext ts --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
