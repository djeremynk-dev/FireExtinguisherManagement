generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INSPECTOR
  USER
}

model User {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String   @unique
  phoneNumber     String?
  role            UserRole @default(USER)
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  jobTitle        String?
  department      String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}